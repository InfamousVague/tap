<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tap host entitlements.

  App Group — write SharedTapState into the Group Container the
  TapWidgets.appex reads. ID must be team-prefixed
  (F6ZAL7ANAD.group.com.mattssoftware.tap) or containermanagerd
  rejects access at runtime.

  HISTORICAL ATTEMPT: added `com.apple.developer.applesignin` so
  `ASAuthorizationAppleIDProvider` could issue a credential. The
  signed binary then refused to launch with `Launchd job spawn
  failed` (POSIX 163) — macOS rejects the entitlement at launch
  unless the App ID `com.mattssoftware.tap` ALSO has "Sign in
  with Apple" enabled at developer.apple.com → Identifiers. Until
  that portal capability is in place, the entitlement makes the
  binary unlaunchable. Reverted; re-add this block (see git
  history) once the dev portal capability is enabled.

  NOT sandboxed: the SSH execute path goes through
  `tap.mattssoftware.com` over HTTPS but the host also stores the
  bearer token in the login Keychain, and SIWA's
  `ASAuthorizationAppleIDProvider` plays nicer outside the sandbox.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>com.apple.security.application-groups</key>
  <array>
    <string>F6ZAL7ANAD.group.com.mattssoftware.tap</string>
  </array>
</dict>
</plist>
