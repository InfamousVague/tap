<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tap host entitlements.

  App Group — write SharedTapState into the Group Container the
  TapWidgets.appex reads. ID must be team-prefixed
  (F6ZAL7ANAD.group.com.mattssoftware.tap) or containermanagerd
  rejects access at runtime. (Group id stays `.tap`, not `.tap.macos`,
  so the existing widget extension and the host find the same
  container — App Groups are a separate registration from the
  primary bundle id.)

  Sign in with Apple — required by `ASAuthorizationAppleIDProvider`.
  This works because the host's CFBundleIdentifier was switched to
  `com.mattssoftware.tap.macos`, which already has SIWA enabled at
  developer.apple.com AND a Developer ID provisioning profile
  generated for it. `scripts/make-app.sh` copies that profile into
  `Contents/embedded.provisionprofile` so launchd's pre-launch
  check accepts the entitlement (without an embedded profile, the
  binary fails to launch with POSIX 163 "Launchd job spawn failed").

  NOT sandboxed: the SSH execute path goes through
  `tap.mattssoftware.com` over HTTPS but the host also stores the
  bearer token in the login Keychain, and SIWA's
  `ASAuthorizationAppleIDProvider` plays nicer outside the sandbox.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>com.apple.security.application-groups</key>
  <array>
    <string>F6ZAL7ANAD.group.com.mattssoftware.tap</string>
  </array>
  <key>com.apple.developer.applesignin</key>
  <array>
    <string>Default</string>
  </array>
</dict>
</plist>
