<?xml version="1.0" encoding="UTF-8"?>
<!--
  TapWidgets.appex entitlements. Sandboxed (mandatory for widget
  extensions on macOS) + App Group so the timeline provider can
  read `SharedTapState` from the same Group Container the host
  writes to. App Group id MUST be team-prefixed
  (`F6ZAL7ANAD.group.com.mattssoftware.tap`) — containermanagerd
  rejects unprefixed ids at runtime on macOS.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.application-groups</key>
  <array>
    <string>F6ZAL7ANAD.group.com.mattssoftware.tap</string>
  </array>
</dict>
</plist>
